# Copy to .env.local to override the defaults.

# SQLite file (default) or a hosted libSQL/Turso database (libsql://...)
DATABASE_URL=file:./data/financecockpit.db
# DATABASE_AUTH_TOKEN=

# Set to false once all accounts exist, so nobody else can sign up.
ALLOW_REGISTRATION=true

# Docker Compose only: the domain Caddy requests a certificate for.
# Use a hard-to-guess subdomain, e.g. fkccmgyu4fxg6t.example.com
# DOMAIN=fkccmgyu4fxg6t.example.com

# Search engines are kept out by default. To allow indexing again, set both:
# ALLOW_INDEXING=true
# ROBOTS_TAG=all
